# 의존성 (npm install로 재생성됨)
node_modules/
proxy/node_modules/
functions/node_modules/

# 민감정보/개인 메모 (커밋 금지)
keys.txt
*.bak
*.bak.*

# 절대 커밋 금지 — 앱 서명 키 (유출 시 앱 위변조 위험)
keystore/
*.jks
*.keystore

# 예외 하나: 테스트 APK 전용 디버그 키 (현장매니저와 같은 방식, 2026-09-01).
# 비밀번호가 안드로이드 표준 기본값(android)이라 비밀이 아니고, 이 키로는 Play 스토어에 못 올린다.
# CI(GitHub Actions)가 매번 새 컨테이너라 이 파일이 없으면 빌드마다 서명이 달라져서
# 테스트 APK를 새로 받을 때마다 '앱을 지우고 다시 설치'해야 했다 — 이걸 막으려고 일부러 커밋한다.
# ☠️ Play 출시용 키는 여기 절대 넣지 말 것 — 위 규칙이 계속 막아준다.
!android/debug.keystore

# 절대 커밋 금지 — 비밀값/환경변수
.env
.env.local
.env.*.local

# 빌드/캐시 산출물
.wrangler/
.firebase/
dist/
build/
.DS_Store
ios/
*.apk
*.aab

# 네이티브 — 산출물(build/·.gradle/·local.properties·assets/public 등)은
# 캡시터가 만든 android/.gitignore 가 이미 걸러준다.
# 여기서는 IDE 설정만 추가로 제외한다.
android/.idea/

# 로그
npm-debug.log*
*.log
